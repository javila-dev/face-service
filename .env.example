# Key compartida por todas las apps clientes. Soporta varias separadas por
# coma si más adelante hace falta una por app (sin cambiar código).
FACE_API_KEYS=change-me-generated-secret

# Modelo InsightFace y backend de ejecución.
FACE_MODEL_NAME=buffalo_l
FACE_PROVIDERS=cpu

# --- Umbrales de calidad/match ---
# Valores pensados para un uso de verificación de identidad (favorecen
# rechazar de más antes que aceptar una foto/persona equivocada). Igual
# son un punto de partida, no una garantía: calibrá con fotos reales de
# tu cámara/caso de uso antes de confiar en esto en producción.

# Similitud coseno mínima para considerar "misma persona". 0.40 es el valor
# típico citado para ArcFace/InsightFace; 0.50 es más conservador (menos
# falsos positivos de identidad, a costa de algún rechazo de más).
FACE_MATCH_THRESHOLD=0.50

# Confianza mínima de detección de rostro. 0.50 es el default del propio
# detector de InsightFace; 0.60 filtra detecciones más dudosas.
FACE_MIN_DET_SCORE=0.60

FACE_MIN_FACE_RATIO=5.0

# Empíricamente calibrado con fotos reales (buffalo_l): crops nítidos dan
# ~250-275, desenfoque apenas visible ~65, desenfoque notorio ~34.
FACE_MIN_LAPLACIAN_VAR=50.0

FACE_MIN_BRIGHTNESS=40.0
FACE_MAX_BRIGHTNESS=220.0

FACE_MAX_IMAGE_MB=10.0
FACE_MIN_RESOLUTION=200
FACE_MODELS_ROOT=/app/models

# --- Pose (yaw=giro, pitch=inclinación vertical, roll=inclinación lateral) ---
# FACE_POSE_BLOCKING=true hace que bad_pose bloquee ok=false para TODAS las
# apps que comparten esta instancia del servicio. Si esta instancia sirve a
# varias apps y no todas necesitan pose estricta (como face.2asoft.tech hoy,
# compartida entre CliniQ y Bodega), dejá esto en false y que cada app mande
# max_yaw/max_pitch/max_roll por request en vez de tocar esta env var — así
# no le cambiás el comportamiento a los demás consumidores.
# Si en cambio esta instancia es dedicada a una sola app, activarlo acá con
# valores más estrictos que el default (35°) es la opción más segura:
FACE_POSE_BLOCKING=false
FACE_MAX_YAW=25.0
FACE_MAX_PITCH=20.0
FACE_MAX_ROLL=20.0

PORT=8000
APP_VERSION=1.1.0
