# Lista de API keys válidas separadas por coma, una por app cliente.
FACE_API_KEYS=change-me-uuid-1,change-me-uuid-2

# Modelo InsightFace y backend de ejecución.
FACE_MODEL_NAME=buffalo_l
FACE_PROVIDERS=cpu

# Umbral de match y umbrales de calidad de foto (todos ajustables sin tocar código).
FACE_MATCH_THRESHOLD=0.40
FACE_MIN_DET_SCORE=0.50
FACE_MIN_FACE_RATIO=5.0
FACE_MIN_LAPLACIAN_VAR=50.0
FACE_MIN_BRIGHTNESS=40.0
FACE_MAX_BRIGHTNESS=220.0

FACE_MAX_IMAGE_MB=10.0
FACE_MIN_RESOLUTION=200
FACE_MODELS_ROOT=/app/models

PORT=8000
APP_VERSION=1.0.0
